# =============================================================================
# ShadeSpot SDK — scripts (open/close/keeper)
# Copy: cp .env.example .env
# Never commit .env — it contains PRIVATE_KEY.
# Set ACTIVE_CHAIN then source, or export INDEX_TOKEN + RPC for one network.
# =============================================================================

PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# --- RPC endpoints ---
ETH_SEPOLIA_RPC_URL=https://rpc.sepolia.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Index tokens (WETH per chain) ---
ETH_SEPOLIA_INDEX_TOKEN=0xf531B8F309Be94191af87605CfBf600D71C2cFe0
ARBITRUM_SEPOLIA_INDEX_TOKEN=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
BASE_SEPOLIA_INDEX_TOKEN=0x4200000000000000000000000000000000000006

# Active chain: eth_sepolia | arbitrum_sepolia | base_sepolia
ACTIVE_CHAIN=arbitrum_sepolia

# Deployed addresses for active chain (from forge deploy logs)
ROUTER_ADDRESS=
POSITION_MANAGER_ADDRESS=
ORDER_MANAGER_ADDRESS=
ORACLE_ADDRESS=
FHE_TOKEN_ADDRESS=
VAULT_ADDRESS=

POLL_INTERVAL_MS=1000
