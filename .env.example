# =============================================================================
# ShadeSpot — multi-chain deploy env (Ethereum / Arbitrum / Base Sepolia)
# Copy: cp .env.example .env  then fill secrets and RPC URLs.
# Never commit .env — it may contain private keys and API keys.
# =============================================================================

# --- Shared (all chains) ---
# Deployer / keeper signer — fund with testnet ETH on each chain you use
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional: address that submits decrypt proofs (defaults to deployer if unset)
# FINALIZER=0x...

# Optional: bootstrap oracle price (8 decimals, e.g. 2500_00000000 = $2500)
# INITIAL_PRICE=0

# Optional: use existing FHE collateral instead of deploying MockFHEToken
# COLLATERAL_TOKEN_FHE=0x...

# Optional: use existing plain ERC-20 instead of deploying MockPlainERC20
# If unset, deploy script deploys MockPlainERC20 and calls vault.setUnderlyingToken
# UNDERLYING_TOKEN=0x...

# Explorer API keys (https://etherscan.io/myapikey — one key often works for all)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# =============================================================================
# Ethereum Sepolia — chainId 11155111
# =============================================================================
ETH_SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Canonical WETH9 on Sepolia
ETH_SEPOLIA_INDEX_TOKEN=0xf531B8F309Be94191af87605CfBf600D71C2cFe0

# Fill after deploy (forge script logs)
# ETH_SEPOLIA_ROUTER=
# ETH_SEPOLIA_POSITION_MANAGER=
# ETH_SEPOLIA_ORDER_MANAGER=
# ETH_SEPOLIA_ORACLE=
# ETH_SEPOLIA_FHE_TOKEN=

# Deploy:
#   source .env && export INDEX_TOKEN=$ETH_SEPOLIA_INDEX_TOKEN
#   forge script script/DeployShadeSpot.s.sol:DeployShadeSpot \
#     --rpc-url sepolia --broadcast --verify \
#     --etherscan-api-key "$ETHERSCAN_API_KEY" -vvv

# =============================================================================
# Arbitrum Sepolia — chainId 421614
# =============================================================================
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Official L2 WETH on Arbitrum Sepolia
ARBITRUM_SEPOLIA_INDEX_TOKEN=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73

# Fill after deploy
# ARBITRUM_SEPOLIA_ROUTER=
# ARBITRUM_SEPOLIA_POSITION_MANAGER=
# ARBITRUM_SEPOLIA_ORDER_MANAGER=
# ARBITRUM_SEPOLIA_ORACLE=
# ARBITRUM_SEPOLIA_FHE_TOKEN=

# Deploy:
#   source .env && export INDEX_TOKEN=$ARBITRUM_SEPOLIA_INDEX_TOKEN
#   forge script script/DeployShadeSpot.s.sol:DeployShadeSpot \
#     --rpc-url arbitrum_sepolia --broadcast --verify \
#     --etherscan-api-key "$ARBISCAN_API_KEY" -vvv

# =============================================================================
# Base Sepolia — chainId 84532
# =============================================================================
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Canonical WETH on Base (OP-stack predeploy)
BASE_SEPOLIA_INDEX_TOKEN=0x4200000000000000000000000000000000000006

# Fill after deploy
# BASE_SEPOLIA_ROUTER=
# BASE_SEPOLIA_POSITION_MANAGER=
# BASE_SEPOLIA_ORDER_MANAGER=
# BASE_SEPOLIA_ORACLE=
# BASE_SEPOLIA_FHE_TOKEN=

# Deploy:
#   source .env && export INDEX_TOKEN=$BASE_SEPOLIA_INDEX_TOKEN
#   forge script script/DeployShadeSpot.s.sol:DeployShadeSpot \
#     --rpc-url base_sepolia --broadcast --verify \
#     --etherscan-api-key "$ETHERSCAN_API_KEY" -vvv

# =============================================================================
# Active deploy target (set before `source .env` / forge)
# Uncomment ONE block so INDEX_TOKEN and RPC match your target chain.
# =============================================================================
# export INDEX_TOKEN=$ETH_SEPOLIA_INDEX_TOKEN
# export INDEX_TOKEN=$ARBITRUM_SEPOLIA_INDEX_TOKEN
# export INDEX_TOKEN=$BASE_SEPOLIA_INDEX_TOKEN
